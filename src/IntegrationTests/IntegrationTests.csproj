<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ContosoUniversity.IntegrationTests</RootNamespace>
    <AssemblyName>ContosoUniversity.IntegrationTests</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Assembly metadata preserved from the original Properties/AssemblyInfo.cs -->
    <AssemblyTitle>IntegrationTests</AssemblyTitle>
    <Product>IntegrationTests</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test framework: Fixie 1.0.1 -> Fixie 4.2.0 (+ VSTest adapter so `dotnet test` works) -->
    <PackageReference Include="Fixie" Version="4.2.0" />
    <PackageReference Include="Fixie.TestAdapter" Version="4.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />

    <!-- Test data / assertions -->
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />

    <!-- Database reset + LocalDB bootstrap -->
    <PackageReference Include="Respawn" Version="7.0.0" />
    <PackageReference Include="MartinCostello.SqlLocalDb" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />

    <!-- RoundhousE migrations (netstandard2.0, loads on net10.0) -->
    <PackageReference Include="roundhouse.core" Version="1.3.1" />
    <PackageReference Include="roundhouse.sqlserver" Version="1.3.1" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <!-- Transitive via roundhouse.core 1.3.1; pinned to patched versions (NU1902/NU1903 advisories) -->
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageReference Include="NHibernate" Version="5.7.0" />

    <!-- Data access: EF6 -> EF Core (version-matched to ContosoUniversity.csproj) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="DelegateDecompiler" Version="0.35.3" />
    <PackageReference Include="DelegateDecompiler.EntityFrameworkCore5" Version="0.35.3" />

    <!-- Application service graph reproduced by the test container -->
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="HtmlTags" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />

    <!-- Retry paths -->
    <PackageReference Include="Polly" Version="8.6.4" />

    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task 23 carry-forward: LocalDbFactory reads <CurrentDirectory>/DatabaseMigration for the
         RoundhousE scripts. SDK-style projects do NOT copy a referenced project's Content, so the
         DBDeployment glob is linked in here as well. -->
    <Content Include="../DatabaseMigration/**/*.sql">
      <Link>DatabaseMigration/%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContosoUniversity\ContosoUniversity.csproj" />
    <ProjectReference Include="..\DBDeployment\DBDeployment.csproj" />
  </ItemGroup>

</Project>
