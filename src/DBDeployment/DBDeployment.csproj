<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DBDeployment</RootNamespace>
    <AssemblyName>DBDeployment</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Assembly metadata preserved from the original Properties/AssemblyInfo.cs -->
    <AssemblyTitle>DBDeployment</AssemblyTitle>
    <Product>DBDeployment</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL migration scripts are the deliverable payload of this project; copied to output. -->
    <Content Include="../DatabaseMigration/**/*.sql">
      <Link>DatabaseMigration/%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
