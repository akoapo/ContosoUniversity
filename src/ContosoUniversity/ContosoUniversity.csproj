<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ContosoUniversity</RootNamespace>
    <AssemblyName>ContosoUniversity</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Data access: EF6 + EntityFramework.SqlServer -> EF Core (SQL Server) -->
    <PackageReference Include="DelegateDecompiler.EntityFrameworkCore5" Version="0.35.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Mapping: AutoMapper 5 + AutoMapper.EF6 -> AutoMapper (DI-based) -->
    <PackageReference Include="AutoMapper" Version="16.2.0" />

    <!-- Validation: FluentValidation 6 + FluentValidation.MVC5 -> FluentValidation 11 + ASP.NET Core integration -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- Messaging: MediatR 2.1 -> MediatR 12 -->
    <PackageReference Include="MediatR" Version="12.5.0" />

    <!-- Paging: PagedList + PagedList.Mvc -> X.PagedList + X.PagedList.Mvc.Core -->
    <PackageReference Include="X.PagedList" Version="10.6.0" />
    <PackageReference Include="X.PagedList.EF" Version="10.6.0" />
    <PackageReference Include="X.PagedList.Mvc.Core" Version="10.6.0" />

    <!-- HTML element generation -->
    <PackageReference Include="HtmlTags" Version="10.0.0" />

    <!-- Computed-property decompilation -->
    <PackageReference Include="DelegateDecompiler" Version="0.35.3" />

    <!-- JSON (ControllerExtensions.JsonNet / ValidatorActionFilter ReferenceLoopHandling) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Transitive via Microsoft.Data.SqlClient; pinned to a patched version (advisory GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
